NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27018/seatbook?replicaSet=rs0
APP_URL=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# A different secret, generated the same way. Signs ticket codes: never reuse JWT_ACCESS_SECRET.
TICKET_SIGNING_SECRET=
# Production only: real confirmation emails through Resend. Leave empty to only log them.
RESEND_API_KEY=
# Password for every demo account the seed creates (npm run seed). 8+ characters, a letter, a digit.
SEED_DEMO_PASSWORD=
# 'off' only for the local load test (npm run load:holds). The API refuses 'off' in production.
RATE_LIMITS=on
